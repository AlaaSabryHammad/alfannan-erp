generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL") // owner connection used by `prisma migrate` (the app itself runs as alfannan_app under RLS)
}

// ── RBAC ─────────────────────────────────────────────────────────────────────

model Role {
  id          Int            @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  code        String
  nameAr      String
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime       @default(now())

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Permission {
  id      Int            @id @default(autoincrement())
  code    String         @unique
  group   String
  nameAr  String
  roles   RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ── USERS ─────────────────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  roleId       Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  // sessions (JWTs) issued before this instant are rejected — set when the password is changed/reset
  sessionsValidAfter DateTime?
  // set when the owner of the mailbox opened the confirmation link
  emailVerifiedAt    DateTime?
  // last successful login (support: who is actually using the system)
  lastLoginAt        DateTime?

  branchId     Int?

  role             Role             @relation(fields: [roleId], references: [id])
  branch            Branch?          @relation("BranchUsers", fields: [branchId], references: [id])
  stockMovements   StockMovement[]
  managedWarehouses Warehouse[]
  salesInvoices    SalesInvoice[]
  workOrders       WorkOrder[]
  stockCountsCreated      StockCount[]
  vouchersCreated         Voucher[]
  journalEntriesCreated   JournalEntry[]
  promissoryNotesCreated  PromissoryNote[]
  fixedAssetsCreated      FixedAsset[]
  payrollRunsCreated      PayrollRun[]
  recurringEntriesCreated RecurringEntry[]
  approvalsCreated        JournalEntryApproval[] @relation("ApprovalMaker")
  approvalsReviewed       JournalEntryApproval[] @relation("ApprovalChecker")
  salesReturnsCreated     SalesReturn[]
  purchaseReturnsCreated  PurchaseReturn[]
  fiscalPeriodsLocked     FiscalPeriod[]
  quotationsCreated       Quotation[]
  salesOrdersCreated      SalesOrder[]
  purchaseOrdersCreated   PurchaseOrder[]
  reconciliationsCreated  BankReconciliation[]

  @@index([tenantId])
}

// ── BRANCHES ──────────────────────────────────────────────────────────────────

model Branch {
  id            Int       @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  nameAr        String
  code          String?   // رمز الفرع — يُستخدم في تقرير مزامنة الفروع
  address       String?
  phone         String?
  isActive      Boolean   @default(true)
  lastSyncedAt  DateTime? // آخر مرة تم فيها تحديث/التحقق من بيانات الفرع يدويًا

  warehouses Warehouse[] @relation("BranchWarehouses")
  users      User[]      @relation("BranchUsers")
  salesInvoices    SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]
  salesReturns     SalesReturn[]
  purchaseReturns  PurchaseReturn[]
  vouchers         Voucher[]
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  purchaseOrders   PurchaseOrder[]

  @@index([tenantId])
}

// ── DEPARTMENTS ───────────────────────────────────────────────────────────────

model Department {
  id            Int          @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  nameAr        String
  descriptionAr String?
  parentId      Int?
  icon          String?
  parent        Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children      Department[] @relation("DepartmentTree")
  products      Product[]

  @@index([tenantId])
}

// ── BRANDS ────────────────────────────────────────────────────────────────────

model Brand {
  id        Int       @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  nameAr    String
  logoUrl   String?
  sortOrder Int       @default(0)
  products  Product[]

  @@index([tenantId])
}

// ── UNITS ─────────────────────────────────────────────────────────────────────

model Unit {
  id       Int       @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  nameAr   String
  code     String
  products Product[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ── PRODUCTS ──────────────────────────────────────────────────────────────────

model Product {
  id           Int            @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  nameAr       String
  sku          String
  barcode      String?
  departmentId Int?
  brandId      Int?
  unitId       Int?
  costPrice    Decimal        @db.Decimal(14, 4) // متوسط التكلفة المتحرك — 4 خانات حتى لا يتراكم فرق التقريب
  salePrice    Decimal        @db.Decimal(12, 2)
  wholesalePrice     Decimal? @db.Decimal(12, 2)
  halfWholesalePrice Decimal? @db.Decimal(12, 2)
  taxRate      Decimal        @db.Decimal(5, 2)  @default(0)
  expiryDate   DateTime?      // تاريخ انتهاء الصلاحية — حقل واحد لكل منتج (وليس دفعات)
  reorderPoint Decimal?       @db.Decimal(12, 2) // حد إعادة الطلب — إذا كان الرصيد أقل منه أو يساويه يُقترح الطلب
  reorderQty   Decimal?       @db.Decimal(12, 2) // الكمية المقترحة لإعادة الطلب (اختياري، وإلا تُحسب تلقائياً)
  imageUrl     String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())

  department     Department?      @relation(fields: [departmentId], references: [id])
  brand          Brand?           @relation(fields: [brandId], references: [id])
  unit           Unit?            @relation(fields: [unitId], references: [id])
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  invoiceItems   SalesInvoiceItem[]
  purchaseItems  PurchaseInvoiceItem[]
  transferItems  StockTransferItem[]
  stockCountLines StockCountLine[]
  bom                  BillOfMaterial? @relation("BOMFinishedProduct")
  bomLinesAsComponent  BOMLine[]       @relation("BOMLineComponent")
  workOrders           WorkOrder[]     @relation("WorkOrderFinishedProduct")
  workOrderLinesAsComponent WorkOrderLine[] @relation("WorkOrderLineComponent")
  salesReturnItems     SalesReturnItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  quotationItems       QuotationItem[]
  salesOrderItems      SalesOrderItem[]
  purchaseOrderItems   PurchaseOrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
}

// ── WAREHOUSES ────────────────────────────────────────────────────────────────

model Warehouse {
  id         Int            @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  nameAr     String
  location   String?
  managerId  Int?
  branchId   Int?
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())

  manager        User?            @relation(fields: [managerId], references: [id])
  branch         Branch?          @relation("BranchWarehouses", fields: [branchId], references: [id])
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  salesInvoices  SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]
  transfersFrom  StockTransfer[]  @relation("TransferFrom")
  transfersTo    StockTransfer[]  @relation("TransferTo")
  stockCounts    StockCount[]
  workOrders     WorkOrder[]
  salesReturns   SalesReturn[]
  purchaseReturns PurchaseReturn[]
  salesOrders    SalesOrder[]
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
}

// ── STOCK ─────────────────────────────────────────────────────────────────────

model StockBalance {
  id          Int       @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  productId   Int
  warehouseId Int
  quantity    Decimal   @db.Decimal(12, 2) @default(0)

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])

  @@index([tenantId])
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUST
}

model StockMovement {
  id           Int          @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  productId    Int
  warehouseId  Int
  type         MovementType
  quantity     Decimal      @db.Decimal(12, 2)
  balanceAfter Decimal      @db.Decimal(12, 2)
  refType      String?
  refId        Int?
  reason       String?
  createdById  Int?
  createdAt    DateTime     @default(now())

  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy   User?     @relation(fields: [createdById], references: [id])

  @@index([productId, warehouseId])
  @@index([refType, refId])
  @@index([createdAt])

  @@index([tenantId])
}

// ── STOCK COUNT (الجرد المخزني) ─────────────────────────────────────────────────

enum StockCountStatus {
  DRAFT
  POSTED
}

model StockCount {
  id          Int              @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  countNo     String
  warehouseId Int
  date        DateTime         @default(now())
  status      StockCountStatus @default(DRAFT)
  notes       String?
  createdById Int?
  postedAt    DateTime?
  createdAt   DateTime         @default(now())

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines     StockCountLine[]

  @@index([warehouseId])
  @@index([status])

  @@unique([tenantId, countNo])
  @@index([tenantId])
}

model StockCountLine {
  id           Int     @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  stockCountId Int
  productId    Int
  systemQty    Decimal @db.Decimal(12, 2)
  countedQty   Decimal @db.Decimal(12, 2)

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([stockCountId, productId])

  @@index([tenantId])
}

// ── MANUFACTURING (أوامر التصنيع وقوائم المكونات) ────────────────────────────────

model BillOfMaterial {
  id        Int       @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  productId Int       @unique // المنتج النهائي — قائمة مكونات واحدة نشطة لكل منتج
  notes     String?
  createdAt DateTime  @default(now())

  product    Product     @relation("BOMFinishedProduct", fields: [productId], references: [id])
  lines      BOMLine[]
  workOrders WorkOrder[]

  @@index([tenantId])
}

model BOMLine {
  id          Int     @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  bomId       Int
  componentId Int
  qtyPerUnit  Decimal @db.Decimal(12, 4) // كمية المكون اللازمة لإنتاج وحدة واحدة من المنتج النهائي

  bom       BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  component Product        @relation("BOMLineComponent", fields: [componentId], references: [id])

  @@unique([bomId, componentId])

  @@index([tenantId])
}

enum WorkOrderStatus {
  DRAFT
  POSTED
  CANCELLED
}

model WorkOrder {
  id          Int             @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  orderNo     String
  bomId       Int
  productId   Int             // المنتج النهائي — نُسخة من bom.productId وقت الإنشاء
  warehouseId Int
  qty         Decimal         @db.Decimal(12, 2) // الكمية المطلوب تصنيعها
  status      WorkOrderStatus @default(DRAFT)
  date        DateTime        @default(now())
  notes       String?
  createdById Int?
  postedAt    DateTime?
  createdAt   DateTime        @default(now())

  bom       BillOfMaterial   @relation(fields: [bomId], references: [id])
  product   Product          @relation("WorkOrderFinishedProduct", fields: [productId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  createdBy User?            @relation(fields: [createdById], references: [id])
  lines     WorkOrderLine[]

  @@index([status])
  @@index([warehouseId])

  @@unique([tenantId, orderNo])
  @@index([tenantId])
}

model WorkOrderLine {
  id          Int     @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  workOrderId Int
  componentId Int
  qtyPerUnit  Decimal @db.Decimal(12, 4) // نسخة من BOMLine وقت إنشاء الأمر
  qtyRequired Decimal @db.Decimal(12, 2) // qtyPerUnit × كمية أمر التصنيع

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  component Product   @relation("WorkOrderLineComponent", fields: [componentId], references: [id])

  @@index([tenantId])
}

// ── CUSTOMERS ─────────────────────────────────────────────────────────────────

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Customer {
  id             Int            @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  nameAr         String
  company        String?
  phone          String?
  vatNumber      String?        // الرقم الضريبي للعميل — للفواتير الضريبية القياسية (B2B)
  creditLimit    Decimal        @db.Decimal(12, 2) @default(0)
  openingBalance Decimal        @db.Decimal(12, 2) @default(0)
  currentBalance Decimal        @db.Decimal(12, 2) @default(0)
  loyaltyPoints  Decimal        @db.Decimal(12, 2) @default(0) // رصيد نقاط الولاء الحالي
  status         CustomerStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())

  invoices            SalesInvoice[]
  loyaltyTransactions LoyaltyTransaction[]
  salesReturns        SalesReturn[]
  quotations          Quotation[]
  salesOrders         SalesOrder[]

  @@index([tenantId])
}

// ── SALES INVOICES ────────────────────────────────────────────────────────────

enum PaidStatus {
  PAID
  UNPAID
  PARTIAL
}

enum PaymentMethod {
  CASH
  CARD
  CREDIT
}

enum ZatcaStatus {
  NOT_CONFIGURED // لم تُضبط بيانات الفوترة الإلكترونية (شهادة الاعتماد) بعد
  PENDING        // جاهزة للإرسال ولم تُرسل بعد
  REPORTED       // تم إرسالها والإبلاغ عنها (فاتورة مبسّطة B2C)
  CLEARED        // تمت المصادقة عليها من هيئة الزكاة والضريبة والجمارك (فاتورة ضريبية B2B)
  FAILED         // فشل الإرسال — راجع zatcaResponse لتفاصيل الخطأ
}

model SalesInvoice {
  id             Int           @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  refNo          String
  customerId     Int
  warehouseId    Int
  cashierId      Int
  branchId       Int?          // فرع المستند — يُشتق من فرع المستودع عند الإنشاء
  date           DateTime      @default(now())
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @db.Decimal(12, 2) @default(0)
  tax            Decimal       @db.Decimal(12, 2) @default(0)
  total          Decimal       @db.Decimal(12, 2)
  paidStatus     PaidStatus    @default(UNPAID)
  // collected in full at the moment of sale (cash / card): the receivable never existed. Needed so that a
  // later return, which re-derives the paid status, cannot turn a paid invoice into an unpaid one.
  settledAtSale  Decimal       @db.Decimal(12, 2) @default(0)
  paymentMethod  PaymentMethod @default(CASH)
  couponId       Int?          // الكوبون المستخدم في هذه الفاتورة (إن وجد)
  pointsEarned   Decimal       @db.Decimal(12, 2) @default(0) // نقاط الولاء المكتسبة من هذه الفاتورة
  pointsRedeemed Decimal       @db.Decimal(12, 2) @default(0) // نقاط الولاء المستبدلة كخصم في هذه الفاتورة
  createdAt      DateTime      @default(now())

  // ── ZATCA Phase 2 (الفوترة الإلكترونية — ربط ومصادقة) ──────────────────────
  invoiceHash         String?      // تجزئة (SHA-256) لمحتوى هذه الفاتورة — لسلسلة الربط
  previousInvoiceHash String?      // تجزئة الفاتورة السابقة في السلسلة (PIH)
  zatcaStatus         ZatcaStatus  @default(NOT_CONFIGURED)
  zatcaUuid           String?      // المُعرّف الفريد المُرسَل إلى هيئة الزكاة
  zatcaSubmittedAt    DateTime?
  zatcaResponse       String?      // آخر استجابة/رسالة خطأ من هيئة الزكاة — للتشخيص
  zatcaSignature      String?      // التوقيع الرقمي (ECDSA) لتجزئة الفاتورة — الختم المميّز
  zatcaQrPayload      String?      // حمولة رمز QR (TLV/Base64) — المرحلة 2 عند التوقيع، وإلا المرحلة 1

  customer            Customer             @relation(fields: [customerId], references: [id])
  warehouse           Warehouse            @relation(fields: [warehouseId], references: [id])
  cashier             User                 @relation(fields: [cashierId], references: [id])
  coupon              Coupon?              @relation(fields: [couponId], references: [id])
  branch              Branch?              @relation(fields: [branchId], references: [id])
  items               SalesInvoiceItem[]
  vouchers            Voucher[]
  loyaltyTransactions LoyaltyTransaction[]
  returns             SalesReturn[]
  salesOrder          SalesOrder?

  @@index([customerId])
  @@index([warehouseId])
  @@index([branchId])
  @@index([date])

  @@unique([tenantId, refNo])
  @@index([tenantId])
}

// ── LOYALTY POINTS & DISCOUNT COUPONS (نقاط الولاء وكوبونات الخصم) ────────────────

enum CouponType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id                Int        @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  code              String
  type              CouponType
  value             Decimal    @db.Decimal(12, 2) // نسبة % أو مبلغ ثابت حسب النوع
  minPurchaseAmount Decimal    @db.Decimal(12, 2) @default(0)
  maxDiscountAmount Decimal?   @db.Decimal(12, 2) // سقف الخصم — يُستخدم فقط مع النوع "نسبة"
  validFrom         DateTime?
  validTo           DateTime?
  usageLimit        Int?       // الحد الأقصى لعدد مرات الاستخدام الإجمالي — null = بلا حد
  usedCount         Int        @default(0)
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())

  invoices SalesInvoice[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

enum LoyaltyTxType {
  EARN
  REDEEM
  ADJUST
}

model LoyaltyTransaction {
  id             Int           @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  customerId     Int
  type           LoyaltyTxType
  points         Decimal       @db.Decimal(12, 2)
  salesInvoiceId Int?
  description    String?
  createdAt      DateTime      @default(now())

  customer     Customer      @relation(fields: [customerId], references: [id])
  salesInvoice SalesInvoice? @relation(fields: [salesInvoiceId], references: [id])

  @@index([tenantId])
}

model SalesInvoiceItem {
  id        Int     @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  invoiceId Int
  productId Int
  qty       Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @db.Decimal(14, 4) @default(0) // متوسط تكلفة الوحدة وقت البيع — لعكس تكلفة البضاعة عند المرتجع بدقة
  lineTotal Decimal @db.Decimal(12, 2)
  // VAT this line carries (after its share of the invoice discount): a return refunds exactly this
  taxAmount Decimal @db.Decimal(12, 2) @default(0)

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])

  @@index([tenantId])
}

// ── QUOTATIONS & ORDERS (عروض الأسعار وأوامر البيع/الشراء) ─────────────────────
// Pre-invoice documents: no stock and no ledger effect. The pipeline is
// عرض سعر → أمر بيع → فاتورة بيع, and أمر شراء → فاتورة شراء.

enum QuotationStatus {
  DRAFT     // مسودة
  SENT      // أُرسل للعميل
  ACCEPTED  // وافق العميل
  REJECTED  // رفضه العميل
  CONVERTED // حُوّل إلى أمر بيع
}

model Quotation {
  id          Int             @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  refNo       String
  customerId  Int
  branchId    Int?
  date        DateTime        @default(now())
  validUntil  DateTime?
  subtotal    Decimal         @db.Decimal(12, 2)
  discount    Decimal         @db.Decimal(12, 2) @default(0)
  tax         Decimal         @db.Decimal(12, 2) @default(0)
  total       Decimal         @db.Decimal(12, 2)
  status      QuotationStatus @default(DRAFT)
  notes       String?
  createdById Int?
  createdAt   DateTime        @default(now())

  customer   Customer        @relation(fields: [customerId], references: [id])
  branch     Branch?         @relation(fields: [branchId], references: [id])
  createdBy  User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items      QuotationItem[]
  salesOrder SalesOrder?     // set once converted

  @@index([customerId])
  @@index([status])
  @@index([date])

  @@unique([tenantId, refNo])
  @@index([tenantId])
}

model QuotationItem {
  id          Int     @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  quotationId Int
  productId   Int
  qty         Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([quotationId])

  @@index([tenantId])
}

enum SalesOrderStatus {
  PENDING   // بانتظار التنفيذ
  FULFILLED // نُفّذ — أُنشئت الفاتورة
  CANCELLED
}

model SalesOrder {
  id           Int              @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  orderNo      String
  customerId   Int
  warehouseId  Int
  branchId     Int?
  quotationId  Int?             @unique // عرض السعر الأصلي إن وُجد
  invoiceId    Int?             @unique // فاتورة البيع الناتجة عن التنفيذ
  date         DateTime         @default(now())
  deliveryDate DateTime?
  subtotal     Decimal          @db.Decimal(12, 2)
  discount     Decimal          @db.Decimal(12, 2) @default(0)
  tax          Decimal          @db.Decimal(12, 2) @default(0)
  total        Decimal          @db.Decimal(12, 2)
  status       SalesOrderStatus @default(PENDING)
  notes        String?
  createdById  Int?
  createdAt    DateTime         @default(now())

  customer  Customer         @relation(fields: [customerId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  branch    Branch?          @relation(fields: [branchId], references: [id])
  quotation Quotation?       @relation(fields: [quotationId], references: [id])
  invoice   SalesInvoice?    @relation(fields: [invoiceId], references: [id])
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     SalesOrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([date])

  @@unique([tenantId, orderNo])
  @@index([tenantId])
}

model SalesOrderItem {
  id           Int     @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  salesOrderId Int
  productId    Int
  qty          Decimal @db.Decimal(12, 2)
  unitPrice    Decimal @db.Decimal(12, 2)
  lineTotal    Decimal @db.Decimal(12, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@index([salesOrderId])

  @@index([tenantId])
}

enum PurchaseOrderStatus {
  PENDING   // بانتظار التحويل لفاتورة
  CONVERTED // حُوّل إلى فاتورة شراء
  CANCELLED
}

model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  orderNo      String
  supplierId   Int
  warehouseId  Int
  branchId     Int?
  invoiceId    Int?                @unique // فاتورة الشراء الناتجة
  date         DateTime            @default(now())
  expectedDate DateTime?
  subtotal     Decimal             @db.Decimal(12, 2)
  discount     Decimal             @db.Decimal(12, 2) @default(0)
  tax          Decimal             @db.Decimal(12, 2) @default(0)
  total        Decimal             @db.Decimal(12, 2)
  status       PurchaseOrderStatus @default(PENDING)
  notes        String?
  createdById  Int?
  createdAt    DateTime            @default(now())

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  branch    Branch?             @relation(fields: [branchId], references: [id])
  invoice   PurchaseInvoice?    @relation(fields: [invoiceId], references: [id])
  createdBy User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@index([date])

  @@unique([tenantId, orderNo])
  @@index([tenantId])
}

model PurchaseOrderItem {
  id              Int     @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  purchaseOrderId Int
  productId       Int
  qty             Decimal @db.Decimal(12, 2)
  unitCost        Decimal @db.Decimal(12, 2)
  lineTotal       Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])

  @@index([tenantId])
}

// ── RETURNS (المرتجعات — إشعارات دائن/مدين) ────────────────────────────────────
// Posted invoices are permanent; undoing part (or all) of a sale/purchase is
// done with a return document that restores stock and reverses the ledger,
// never by deleting the original invoice.

enum RefundMethod {
  CASH    // ردّ نقدي من/إلى الخزينة
  BALANCE // على الحساب — يخفّض مديونية العميل أو مستحقات المورد
}

model SalesReturn {
  id             Int          @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  refNo          String
  salesInvoiceId Int
  customerId     Int
  warehouseId    Int
  branchId       Int?         // فرع المستند — يرث فرع الفاتورة الأصلية
  date           DateTime     @default(now())
  subtotal       Decimal      @db.Decimal(12, 2) // إجمالي بنود المرتجع بأسعار الفاتورة الأصلية
  discount       Decimal      @db.Decimal(12, 2) @default(0) // نصيب المرتجع من خصم الفاتورة (نسبي)
  tax            Decimal      @db.Decimal(12, 2) @default(0) // نصيب المرتجع من ضريبة الفاتورة (نسبي)
  total          Decimal      @db.Decimal(12, 2) // subtotal - discount + tax = المبلغ المسترد
  refundMethod   RefundMethod @default(BALANCE)
  reason         String?
  createdById    Int?
  createdAt      DateTime     @default(now())

  salesInvoice SalesInvoice      @relation(fields: [salesInvoiceId], references: [id])
  customer     Customer          @relation(fields: [customerId], references: [id])
  warehouse    Warehouse         @relation(fields: [warehouseId], references: [id])
  branch       Branch?           @relation(fields: [branchId], references: [id])
  createdBy    User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items        SalesReturnItem[]

  @@index([salesInvoiceId])
  @@index([customerId])
  @@index([branchId])
  @@index([date])

  @@unique([tenantId, refNo])
  @@index([tenantId])
}

model SalesReturnItem {
  id        Int     @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  returnId  Int
  productId Int
  qty       Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2) // سعر البيع من الفاتورة الأصلية
  lineTotal Decimal @db.Decimal(12, 2)

  return  SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])

  @@index([tenantId])
}

model PurchaseReturn {
  id                Int          @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  refNo             String
  purchaseInvoiceId Int
  supplierId        Int
  warehouseId       Int
  branchId          Int?         // فرع المستند — يرث فرع الفاتورة الأصلية
  date              DateTime     @default(now())
  subtotal          Decimal      @db.Decimal(12, 2)
  discount          Decimal      @db.Decimal(12, 2) @default(0)
  tax               Decimal      @db.Decimal(12, 2) @default(0)
  total             Decimal      @db.Decimal(12, 2)
  refundMethod      RefundMethod @default(BALANCE)
  reason            String?
  createdById       Int?
  createdAt         DateTime     @default(now())

  purchaseInvoice PurchaseInvoice      @relation(fields: [purchaseInvoiceId], references: [id])
  supplier        Supplier             @relation(fields: [supplierId], references: [id])
  warehouse       Warehouse            @relation(fields: [warehouseId], references: [id])
  branch          Branch?              @relation(fields: [branchId], references: [id])
  createdBy       User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items           PurchaseReturnItem[]

  @@index([purchaseInvoiceId])
  @@index([supplierId])
  @@index([branchId])
  @@index([date])

  @@unique([tenantId, refNo])
  @@index([tenantId])
}

model PurchaseReturnItem {
  id        Int     @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  returnId  Int
  productId Int
  qty       Decimal @db.Decimal(12, 2)
  unitCost  Decimal @db.Decimal(12, 2) // تكلفة الشراء من الفاتورة الأصلية
  lineTotal Decimal @db.Decimal(12, 2)

  return  PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])

  @@index([tenantId])
}

// ── SUPPLIERS ─────────────────────────────────────────────────────────────────

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Supplier {
  id             Int            @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  nameAr         String
  company        String?
  phone          String?
  openingBalance Decimal        @db.Decimal(12, 2) @default(0)
  currentBalance Decimal        @db.Decimal(12, 2) @default(0)
  status         SupplierStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())

  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]
  purchaseOrders   PurchaseOrder[]

  @@index([tenantId])
}

// ── PURCHASE INVOICES ─────────────────────────────────────────────────────────

enum ReceiveStatus {
  RECEIVED
  PENDING
}

model PurchaseInvoice {
  id            Int           @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  refNo         String
  supplierId    Int
  warehouseId   Int
  branchId      Int?          // فرع المستند — يُشتق من فرع المستودع عند الإنشاء
  date          DateTime      @default(now())
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @db.Decimal(12, 2) @default(0)
  tax           Decimal       @db.Decimal(12, 2) @default(0)
  total         Decimal       @db.Decimal(12, 2)
  paymentStatus PaidStatus    @default(UNPAID)
  // paid in full when the purchase was entered (no payable was ever raised)
  settledAtPurchase Decimal   @db.Decimal(12, 2) @default(0)
  receiveStatus ReceiveStatus @default(PENDING)
  notes         String?
  createdAt     DateTime      @default(now())

  supplier  Supplier             @relation(fields: [supplierId], references: [id])
  warehouse Warehouse            @relation(fields: [warehouseId], references: [id])
  branch    Branch?              @relation(fields: [branchId], references: [id])
  items     PurchaseInvoiceItem[]
  vouchers  Voucher[]
  returns   PurchaseReturn[]
  purchaseOrder PurchaseOrder?

  @@index([supplierId])
  @@index([warehouseId])
  @@index([branchId])
  @@index([date])

  @@unique([tenantId, refNo])
  @@index([tenantId])
}

model PurchaseInvoiceItem {
  id        Int     @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  invoiceId Int
  productId Int
  qty       Decimal @db.Decimal(12, 2)
  unitCost  Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  invoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])

  @@index([tenantId])
}

// ── ACCOUNTS ──────────────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id             Int         @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  code           String
  nameAr         String
  type           AccountType
  parentId       Int?
  openingBalance Decimal     @db.Decimal(12, 2) @default(0)
  currentBalance Decimal     @db.Decimal(12, 2) @default(0)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())

  parent       Account?       @relation("AccountTree", fields: [parentId], references: [id])
  children     Account[]      @relation("AccountTree")
  expenses     Expense[]
  journalLines JournalLine[]
  voucherTreasury Voucher[]   @relation("VoucherTreasuryAccount")
  voucherLines VoucherLine[]
  bankReconciliations BankReconciliation[]
  budgets      Budget[]
  recurringEntryLines RecurringEntryLine[]
  approvalLines JournalEntryApprovalLine[]

  @@index([type])
  @@index([parentId])

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ── FISCAL PERIODS (إقفال الفترات المحاسبية) ──────────────────────────────────
// A LOCKED month rejects any journal posting or reversal dated inside it —
// enforced at the single ledger choke point (postJournalEntry /
// reverseJournalEntryBySource), which covers every document type.

enum PeriodStatus {
  OPEN
  LOCKED
}

model FiscalPeriod {
  id         Int          @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  year       Int
  month      Int // 1-12
  status     PeriodStatus @default(OPEN)
  lockedAt   DateTime?
  lockedById Int?

  lockedBy User? @relation(fields: [lockedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, year, month])

  @@index([tenantId])
}

// ── JOURNAL ───────────────────────────────────────────────────────────────────

enum JournalSource {
  SALES_INVOICE
  PURCHASE_INVOICE
  SALES_RETURN
  PURCHASE_RETURN
  EXPENSE
  MANUAL
  OPENING
  VOUCHER
  DEPRECIATION
  PAYROLL
  YEAR_CLOSE
  RECURRING
  STOCK_ADJUSTMENT
}

model JournalEntry {
  id          Int           @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  entryNo     String
  date        DateTime
  description String
  sourceType  JournalSource
  sourceId    Int?
  totalDebit  Decimal       @db.Decimal(12, 2)
  totalCredit Decimal       @db.Decimal(12, 2)
  createdById Int?
  createdAt   DateTime      @default(now())

  lines JournalLine[]
  voucher Voucher?
  approvalRequest JournalEntryApproval?
  payrollRun PayrollRun?
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([sourceType, sourceId])
  @@index([date])

  @@unique([tenantId, entryNo])
  @@index([tenantId])
}

model JournalLine {
  id          Int     @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  entryId     Int
  accountId   Int
  costCenterId Int?
  debit       Decimal @db.Decimal(12, 2) @default(0)
  credit      Decimal @db.Decimal(12, 2) @default(0)
  description String?

  entry      JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account    Account      @relation(fields: [accountId], references: [id])
  costCenter CostCenter?  @relation(fields: [costCenterId], references: [id])
  reconciliationLine BankReconciliationLine?

  @@index([accountId])
  @@index([entryId])
  @@index([costCenterId])

  @@index([tenantId])
}

// ── COST CENTERS (مراكز التكلفة) ──────────────────────────────────────────────

model CostCenter {
  id        Int      @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  code      String
  nameAr    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  journalLines JournalLine[]
  budgets      Budget[]
  recurringEntryLines RecurringEntryLine[]
  approvalLines JournalEntryApprovalLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ── BUDGETS (الموازنات التقديرية) ──────────────────────────────────────────────

model Budget {
  id           Int      @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  accountId    Int
  costCenterId Int?
  year         Int
  month        Int      // 1-12
  amount       Decimal  @db.Decimal(12, 2) @default(0)
  createdAt    DateTime @default(now())

  account    Account     @relation(fields: [accountId], references: [id])
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id])

  @@unique([accountId, costCenterId, year, month])
  @@index([year, month])

  @@index([tenantId])
}

// ── RECURRING JOURNAL ENTRIES (القيود المتكررة) ────────────────────────────────

model RecurringEntry {
  id          Int       @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  description String
  dayOfMonth  Int       @default(1) // 1-28, day of month to post on
  startDate   DateTime  @default(now())
  endDate     DateTime?
  lastRunDate DateTime?
  isActive    Boolean   @default(true)
  createdById Int?
  createdAt   DateTime  @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines RecurringEntryLine[]

  @@index([tenantId])
}

model RecurringEntryLine {
  id               Int     @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  recurringEntryId Int
  accountId        Int
  costCenterId     Int?
  debit            Decimal @db.Decimal(12, 2) @default(0)
  credit           Decimal @db.Decimal(12, 2) @default(0)
  description      String?

  recurringEntry RecurringEntry @relation(fields: [recurringEntryId], references: [id], onDelete: Cascade)
  account        Account        @relation(fields: [accountId], references: [id])
  costCenter     CostCenter?    @relation(fields: [costCenterId], references: [id])

  @@index([recurringEntryId])
  @@index([accountId])

  @@index([tenantId])
}

// ── JOURNAL ENTRY APPROVALS (سير الاعتماد — Maker-Checker) ─────────────────────
// Manual journal entries are staged here first; the account balances are only
// touched once a *different* user (never the maker) approves the request.

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model JournalEntryApproval {
  id             Int            @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  description    String
  date           DateTime
  status         ApprovalStatus @default(PENDING)
  createdById    Int
  reviewedById   Int?
  reviewedAt     DateTime?
  rejectReason   String?
  journalEntryId Int?           @unique
  createdAt      DateTime       @default(now())

  lines        JournalEntryApprovalLine[]
  journalEntry JournalEntry?              @relation(fields: [journalEntryId], references: [id])
  createdBy    User                       @relation("ApprovalMaker", fields: [createdById], references: [id])
  reviewedBy   User?                      @relation("ApprovalChecker", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])

  @@index([tenantId])
}

model JournalEntryApprovalLine {
  id           Int     @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  requestId    Int
  accountId    Int
  costCenterId Int?
  debit        Decimal @db.Decimal(12, 2) @default(0)
  credit       Decimal @db.Decimal(12, 2) @default(0)
  description  String?

  request    JournalEntryApproval @relation(fields: [requestId], references: [id], onDelete: Cascade)
  account    Account              @relation(fields: [accountId], references: [id])
  costCenter CostCenter?          @relation(fields: [costCenterId], references: [id])

  @@index([requestId])
  @@index([accountId])

  @@index([tenantId])
}

// ── BANK RECONCILIATION (التسوية البنكية) ─────────────────────────────────────
// Matches journal lines on a bank/cash account against the real bank
// statement. A journal line can be reconciled exactly once, ever.

enum ReconciliationStatus {
  DRAFT
  COMPLETED
}

model BankReconciliation {
  id               Int                  @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  reconNo          String
  accountId        Int                  // حساب البنك/الخزينة موضوع التسوية
  statementDate    DateTime             // تاريخ كشف البنك
  statementBalance Decimal              @db.Decimal(12, 2) // الرصيد حسب كشف البنك
  clearedBalance   Decimal              @db.Decimal(12, 2) @default(0) // الرصيد الدفتري المُسوّى عند الإكمال
  difference       Decimal              @db.Decimal(12, 2) @default(0) // كشف البنك − الدفتري المُسوّى
  status           ReconciliationStatus @default(DRAFT)
  notes            String?
  createdById      Int?
  completedAt      DateTime?
  createdAt        DateTime             @default(now())

  account   Account                   @relation(fields: [accountId], references: [id])
  createdBy User?                     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines     BankReconciliationLine[]

  @@index([accountId])
  @@index([status])

  @@unique([tenantId, reconNo])
  @@index([tenantId])
}

model BankReconciliationLine {
  id               Int @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  reconciliationId Int
  journalLineId    Int @unique // السطر يُسوّى مرة واحدة فقط عبر كل الجلسات

  reconciliation BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  journalLine    JournalLine        @relation(fields: [journalLineId], references: [id])

  @@index([reconciliationId])

  @@index([tenantId])
}

// ── PARTNERS ──────────────────────────────────────────────────────────────────

enum PartnerStatus {
  ACTIVE
  INACTIVE
}

model Partner {
  id              Int           @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  nameAr          String
  email           String?
  phone           String?
  capitalRequired Decimal       @db.Decimal(12, 2) @default(0)
  capitalPaid     Decimal       @db.Decimal(12, 2) @default(0)
  profitSharePct  Decimal       @db.Decimal(5, 2)  @default(0)
  currentBalance  Decimal       @db.Decimal(12, 2) @default(0)
  status          PartnerStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())

  @@index([tenantId])
}

// ── STOCK TRANSFERS ───────────────────────────────────────────────────────────

enum TransferStatus {
  DONE
  PENDING
}

model StockTransfer {
  id                Int            @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  transferNo        String
  fromWarehouseId   Int
  toWarehouseId     Int
  date              DateTime       @default(now())
  status            TransferStatus @default(PENDING)
  notes             String?
  createdAt         DateTime       @default(now())

  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items         StockTransferItem[]

  @@index([fromWarehouseId])
  @@index([toWarehouseId])

  @@unique([tenantId, transferNo])
  @@index([tenantId])
}

model StockTransferItem {
  id         Int     @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  transferId Int
  productId  Int
  qty        Decimal @db.Decimal(12, 2)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])

  @@index([tenantId])
}

// ── SETTINGS ─────────────────────────────────────────────────────────────────

model Setting {
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([tenantId, key])
  @@index([tenantId])
}

// ── AUDIT LOG ─────────────────────────────────────────────────────────────────

model AuditLog {
  id         Int      @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  userId     Int?
  userName   String?
  method     String
  path       String
  action     String?
  entity     String?
  statusCode Int
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])

  @@index([tenantId])
}

// ── EXPENSES ──────────────────────────────────────────────────────────────────

model Expense {
  id          Int      @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  accountId   Int?
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  description String?
  createdAt   DateTime @default(now())

  account Account? @relation(fields: [accountId], references: [id])

  @@index([date])
  @@index([accountId])

  @@index([tenantId])
}

// ── VOUCHERS / TREASURY ───────────────────────────────────────────────────────

enum VoucherType {
  RECEIPT
  PAYMENT
  DISCOUNT
  DEPOSIT
}

enum PartyType {
  CUSTOMER
  SUPPLIER
  ACCOUNT
}

model Voucher {
  id                Int         @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  voucherNo         String
  type              VoucherType
  date              DateTime    @default(now())
  treasuryAccountId Int
  partyType         PartyType?
  partyId           Int?
  salesInvoiceId    Int?
  purchaseInvoiceId Int?
  branchId          Int?        // فرع المستند — يُشتق من فرع منشئ السند
  description       String?
  totalAmount       Decimal     @db.Decimal(12, 2) @default(0)
  journalEntryId    Int?        @unique
  createdById       Int?
  createdAt         DateTime    @default(now())

  treasuryAccount Account          @relation("VoucherTreasuryAccount", fields: [treasuryAccountId], references: [id])
  journalEntry    JournalEntry?    @relation(fields: [journalEntryId], references: [id])
  salesInvoice    SalesInvoice?    @relation(fields: [salesInvoiceId], references: [id])
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
  branch          Branch?          @relation(fields: [branchId], references: [id])
  createdBy       User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines           VoucherLine[]
  settledNotes    PromissoryNote[]

  @@index([type])
  @@index([date])
  @@index([treasuryAccountId])
  @@index([partyType, partyId])
  @@index([salesInvoiceId])
  @@index([purchaseInvoiceId])
  @@index([branchId])

  @@unique([tenantId, voucherNo])
  @@index([tenantId])
}

model VoucherLine {
  id          Int            @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  voucherId   Int
  accountId   Int
  amount      Decimal        @db.Decimal(12, 2) @default(0)
  description String?

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@index([voucherId])
  @@index([accountId])

  @@index([tenantId])
}

// ── PROMISSORY NOTES (الكمبيالات) ─────────────────────────────────────────────

enum NoteType {
  RECEIVABLE
  PAYABLE
}

enum NoteStatus {
  PENDING
  SETTLED
  CANCELLED
  BOUNCED
}

enum NoteInstrumentType {
  PROMISSORY_NOTE
  CHEQUE
}

model PromissoryNote {
  id                Int       @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  noteNo            String
  type              NoteType
  instrumentType    NoteInstrumentType @default(PROMISSORY_NOTE)
  bankName          String?   // اسم البنك — للشيكات فقط
  partyType         PartyType
  partyId           Int?
  amount            Decimal   @db.Decimal(12, 2) @default(0)
  issueDate         DateTime  @default(now())
  dueDate           DateTime
  status            NoteStatus @default(PENDING)
  description       String?
  settledVoucherId  Int?
  createdById       Int?
  createdAt         DateTime  @default(now())

  settledVoucher Voucher? @relation(fields: [settledVoucherId], references: [id])
  createdBy      User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([dueDate])
  @@index([partyType, partyId])

  @@unique([tenantId, noteNo])
  @@index([tenantId])
}

// ── FIXED ASSETS (الأصول الثابتة) ─────────────────────────────────────────────

enum AssetCategory {
  EQUIPMENT
  VEHICLE
  FURNITURE
  BUILDING
  OTHER
}

enum DepreciationMethod {
  STRAIGHT_LINE
}

enum AssetStatus {
  ACTIVE
  DISPOSED
}

model FixedAsset {
  id                       Int                 @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  assetCode                String
  nameAr                   String
  category                 AssetCategory       @default(OTHER)
  purchaseDate             DateTime            @default(now())
  purchaseCost             Decimal             @db.Decimal(12, 2)
  salvageValue             Decimal             @db.Decimal(12, 2) @default(0)
  usefulLifeMonths         Int
  depreciationMethod       DepreciationMethod  @default(STRAIGHT_LINE)
  accumulatedDepreciation  Decimal             @db.Decimal(12, 2) @default(0)
  bookValue                Decimal             @db.Decimal(12, 2) @default(0)
  status                   AssetStatus         @default(ACTIVE)
  description              String?
  createdById              Int?
  createdAt                DateTime            @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([status])

  @@unique([tenantId, assetCode])
  @@index([tenantId])
}

// ── HUMAN RESOURCES / PAYROLL (الموارد البشرية والرواتب) ──────────────────────

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum PayrollStatus {
  DRAFT
  POSTED
}

model Employee {
  id           Int             @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  nameAr       String
  nationalId   String?
  phone        String?
  position     String?
  department   String?
  managerId    Int?            // المسؤول المباشر — يُستخدم لبناء الهيكل التنظيمي
  basicSalary  Decimal         @db.Decimal(12, 2) @default(0)
  allowances   Decimal         @db.Decimal(12, 2) @default(0)
  deductions   Decimal         @db.Decimal(12, 2) @default(0)
  bankAccount  String?
  hireDate     DateTime        @default(now())
  status       EmployeeStatus  @default(ACTIVE)
  createdAt    DateTime        @default(now())

  manager       Employee?     @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports Employee[]    @relation("EmployeeManager")
  payrollItems  PayrollItem[]

  @@index([status])

  @@index([tenantId])
}

model PayrollRun {
  id          Int           @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  runNo       String
  month       Int
  year        Int
  totalGross  Decimal       @db.Decimal(12, 2) @default(0)
  totalDeductions Decimal    @db.Decimal(12, 2) @default(0)
  totalNet    Decimal       @db.Decimal(12, 2) @default(0)
  status      PayrollStatus @default(DRAFT)
  journalEntryId Int?       @unique
  createdById Int?
  createdAt   DateTime      @default(now())

  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items PayrollItem[]

  @@index([month, year])

  @@unique([tenantId, runNo])
  @@index([tenantId])
}

model PayrollItem {
  id           Int       @id @default(autoincrement())
  tenantId     Int @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  payrollRunId Int
  employeeId   Int
  basic        Decimal   @db.Decimal(12, 2) @default(0)
  allowances   Decimal   @db.Decimal(12, 2) @default(0)
  deductions   Decimal   @db.Decimal(12, 2) @default(0)
  net          Decimal   @db.Decimal(12, 2) @default(0)

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@index([payrollRunId])
  @@index([employeeId])

  @@index([tenantId])
}


// ── TENANTS (SaaS) ────────────────────────────────────────────────────────────

model Tenant {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // acceptance of the Terms of Service / Privacy Policy (who, when, which version, from where)
  termsVersion    String?
  termsAcceptedAt DateTime?
  termsAcceptedBy String?
  termsAcceptedIp String?

  // internal notes of the platform owner (never shown to the company)
  platformNote String?

  roleRows Role[]
  userRows User[]
  branchRows Branch[]
  departmentRows Department[]
  brandRows Brand[]
  unitRows Unit[]
  productRows Product[]
  warehouseRows Warehouse[]
  stockBalanceRows StockBalance[]
  stockMovementRows StockMovement[]
  stockCountRows StockCount[]
  stockCountLineRows StockCountLine[]
  billOfMaterialRows BillOfMaterial[]
  bOMLineRows BOMLine[]
  workOrderRows WorkOrder[]
  workOrderLineRows WorkOrderLine[]
  customerRows Customer[]
  salesInvoiceRows SalesInvoice[]
  couponRows Coupon[]
  loyaltyTransactionRows LoyaltyTransaction[]
  salesInvoiceItemRows SalesInvoiceItem[]
  quotationRows Quotation[]
  quotationItemRows QuotationItem[]
  salesOrderRows SalesOrder[]
  salesOrderItemRows SalesOrderItem[]
  purchaseOrderRows PurchaseOrder[]
  purchaseOrderItemRows PurchaseOrderItem[]
  salesReturnRows SalesReturn[]
  salesReturnItemRows SalesReturnItem[]
  purchaseReturnRows PurchaseReturn[]
  purchaseReturnItemRows PurchaseReturnItem[]
  supplierRows Supplier[]
  purchaseInvoiceRows PurchaseInvoice[]
  purchaseInvoiceItemRows PurchaseInvoiceItem[]
  accountRows Account[]
  fiscalPeriodRows FiscalPeriod[]
  journalEntryRows JournalEntry[]
  journalLineRows JournalLine[]
  costCenterRows CostCenter[]
  budgetRows Budget[]
  recurringEntryRows RecurringEntry[]
  recurringEntryLineRows RecurringEntryLine[]
  journalEntryApprovalRows JournalEntryApproval[]
  journalEntryApprovalLineRows JournalEntryApprovalLine[]
  bankReconciliationRows BankReconciliation[]
  bankReconciliationLineRows BankReconciliationLine[]
  partnerRows Partner[]
  stockTransferRows StockTransfer[]
  stockTransferItemRows StockTransferItem[]
  settingRows Setting[]
  auditLogRows AuditLog[]
  expenseRows Expense[]
  voucherRows Voucher[]
  voucherLineRows VoucherLine[]
  promissoryNoteRows PromissoryNote[]
  fixedAssetRows FixedAsset[]
  employeeRows Employee[]
  payrollRunRows PayrollRun[]
  payrollItemRows PayrollItem[]
  subscription Subscription?
  subscriptionPayments SubscriptionPayment[]
  upgradeRequests UpgradeRequest[]
  paymentOrders PaymentOrder[]
}

// ── PLATFORM ADMINS (SaaS owner console — not tenant users, no tenantId, no RLS) ──────────────
// Read/written only through the owner connection (lib/platformPrisma.ts); the app role has no access.

model PlatformAdmin {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  // tokens issued before this instant are rejected (set when the password changes)
  sessionsValidAfter DateTime?
  // OWNER = everything · SUPPORT = read + help users (see routes/platformAdmins.ts)
  role               String    @default("OWNER")
  // set when an owner created the account or reset the password: the console asks for a new one
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?

  auditLogs PlatformAuditLog[]
}

model PlatformAuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int?
  action    String // TENANT_SUSPEND | TENANT_ACTIVATE | TENANT_RENAME | USER_PASSWORD_RESET | LOGIN
  tenantId  Int?
  detail    String?
  createdAt DateTime @default(now())

  admin PlatformAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdAt])
}

// Announcements published by the platform owner; every company's users see the active ones.
model Announcement {
  id        Int       @id @default(autoincrement())
  title     String
  body      String
  level     String    @default("INFO") // INFO | WARNING | CRITICAL
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Platform-wide switches set from the console (e.g. signup.enabled). Owner connection only.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ── PLANS & SUBSCRIPTIONS (SaaS billing) ──────────────────────────────────────────────────────
// Plan is global (managed by the platform owner). Subscription is per tenant and read-only for the
// tenant application role: only the owner console changes plans, periods and overrides.

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELED
}

model Plan {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  nameAr       String
  priceMonthly Decimal  @default(0) @db.Decimal(12, 2)
  priceYearly  Decimal  @default(0) @db.Decimal(12, 2)
  currency     String   @default("SAR")
  trialDays    Int      @default(0)
  limits       Json // { users, branches, warehouses, products, salesInvoicesPerMonth } — null = unlimited
  features     Json // { zatca, manufacturing, advancedReports } — true/false
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id                 Int                @id @default(autoincrement())
  tenantId           Int                @unique @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  planId             Int
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  limitOverrides     Json? // per-company limits that win over the plan's
  featureOverrides   Json?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

// Payments are recorded by the platform owner (bank transfer / cash for now). A company can read its
// own history; only the owner connection writes.
model SubscriptionPayment {
  id             Int       @id @default(autoincrement())
  tenantId       Int       @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  planId         Int
  amount         Decimal   @db.Decimal(12, 2)
  currency       String    @default("SAR")
  method         String // CASH | BANK_TRANSFER | CARD | OTHER
  reference      String?
  months         Int
  periodStart    DateTime
  periodEnd      DateTime
  note           String?
  recordedByName String?
  createdAt      DateTime  @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

// A company asks for a plan change from inside the app; the owner sees it in the platform console.
// The company can create and read its own requests, never edit them (handled by the owner only).
model UpgradeRequest {
  id               Int       @id @default(autoincrement())
  tenantId         Int       @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  requestedPlanId  Int
  message          String?
  status           String    @default("PENDING") // PENDING | HANDLED
  requestedByName  String?
  requestedByEmail String?
  createdAt        DateTime  @default(now())
  handledAt        DateTime?
  handledByName    String?

  @@index([tenantId])
  @@index([status])
}

// An online checkout started by a company. Created by the company (INSERT), settled only by the payment
// webhook / reconciliation job through the owner connection — never by the tenant itself.
model PaymentOrder {
  id                Int       @id @default(autoincrement())
  tenantId          Int       @default(dbgenerated("(current_setting('app.tenant_id'::text))::integer"))
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  planId            Int
  months            Int
  amount            Decimal   @db.Decimal(12, 2)
  currency          String    @default("SAR")
  status            String    @default("PENDING") // PENDING | PAID | FAILED | EXPIRED
  provider          String // moyasar | fake
  providerInvoiceId String?   @unique
  providerPaymentId String?   @unique
  checkoutUrl       String?
  failureReason     String?
  requestedById     Int?
  createdAt         DateTime  @default(now())
  paidAt            DateTime?

  @@index([tenantId])
  @@index([status, createdAt])
}
