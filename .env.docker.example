# انسخ هذا الملف إلى .env.docker وعدّل القيم قبل docker compose up
DB_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-long-random-hex
# Password of the non-superuser DB role the app runs as (Row-Level Security). 16+ chars of [A-Za-z0-9_-].
APP_DB_PASSWORD=change-me-another-strong-password
WEB_PORT=8080
CORS_ORIGIN=http://localhost:8080

# SaaS: true = the login screen offers "create your company" (self-service sign-up). Keep false for a private install.
ALLOW_SIGNUP=false

# Plan limits/features: log = only record what would be blocked (safe roll-out), enforce = answer 402, off = ignore.
SUBSCRIPTION_ENFORCEMENT=log

# Online payments (docs/PAYMENTS.md). Keep PAYMENTS_ENABLED=false until the keys below are set.
PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER=moyasar
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
